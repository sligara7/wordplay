        "function_name": "transcribe",
        "file": "audio_to_midi_pipeline.py",
        "signature": "transcribe(wav_path: str, output_path: str, intensity_threshold: float = 0.05, confidence_threshold: float = 0.3, min_duration_samples: int = 3, tempo: int = 120) -> str",
        "description": "Main transcription function coordinating all components",
        "parameters": [
          {"name": "wav_path", "type": "str", "description": "Path to input WAV file"},
          {"name": "output_path", "type": "str", "description": "Path for output MIDI file"},
          {"name": "intensity_threshold", "type": "float", "description": "Minimum intensity for graph nodes"},
          {"name": "confidence_threshold", "type": "float", "description": "Minimum confidence for fundamentals"},
          {"name": "min_duration_samples", "type": "int", "description": "Minimum sustained duration"},
          {"name": "tempo", "type": "int", "description": "Tempo in BPM for MIDI file"}
        ],
        "returns": "Path to created MIDI file",
        "logic": [
          "1. Validate input file exists and is WAV format",
          "2. Load and analyze audio:",
          "   - Read WAV file using scipy.io.wavfile",
          "   - Extract left channel if stereo",
          "   - Create SpectralAnalyzer instance",
          "   - Run spectral analysis: spectral_data = analyzer.dotop(audio)",
          "3. Build audio graph:",
          "   - Create AudioGraphBuilder with spectral data",
          "   - Set intensity_threshold",
          "   - Build graph with temporal and harmonic edges",
          "4. Analyze harmonics:",
          "   - Create HarmonicAnalyzer with graph",
          "   - Detect fundamentals: fundamentals = analyzer.analyze_all_time_samples()",
          "   - Filter noise: filtered = analyzer.filter_noise(confidence_threshold, min_duration_samples)",
          "5. Detect onsets:",
          "   - Create OnsetDetector with graph",
          "   - Detect onsets from fundamentals: note_events = detector.detect_onsets(filtered)",
          "6. Generate MIDI:",
          "   - Create MidiGenerator with tempo",
          "   - Generate MIDI file: midi_path = generator.generate_midi(note_events, output_path)",
          "7. Return path to created MIDI file",
          "ERROR HANDLING:",
          "   - Wrap each step in try-except",
          "   - Provide helpful error messages for each failure mode",
          "   - Clean up partial outputs on failure"
        ],
        "estimated_lines": "80-120"
      },
